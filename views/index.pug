extends layout

block content
  h1 Simple Shop

  ul
    each product in products
      li
        strong #{product.name}
        |  - #{product.price}zł
        form(action="/cart" method="POST" style="display:inline")
          input(type="hidden" name="productId" value=product.id)
          button(type="submit") Add to cart

  br
  a(href="/cart") View cart
