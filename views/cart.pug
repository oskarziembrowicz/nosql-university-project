extends layout

block content
  h1 Your Cart

  if cartItems.length === 0
    if successMessage
      p(style="color: green; font-weight: bold") #{successMessage}
    else
      p Your cart is empty.
    a(href="/") Back to shop
  else
    table
      tr
        th Product
        th Quantity
        th Price
        th Actions

      each item in cartItems
        if item.product
          tr
            td #{item.product.name}
            td #{item.quantity}
            td #{item.total.toFixed(2)}zł
            td
              form(action=`/cart/${item.product.id}` method="POST")
                button(type="submit") Remove

    p
      strong Total: #{cartTotal.toFixed(2)}zł

    form(action="/cart/buy" method="POST")
      button(type="submit") Confirm Purchase

    form(action="/cart/clear" method="GET")
      button(type="submit") Clear cart

    br
    a(href="/") Continue shopping
